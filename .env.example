# Asistente Personal WhatsApp — Variables de entorno
# Copia este archivo a .env y llena tus datos. NUNCA subas .env a GitHub.

# Anthropic API (el cerebro del asistente)
ANTHROPIC_API_KEY=sk-ant-...

# Tu numero de WhatsApp (el DUEÑO del asistente).
# Solo este numero puede darle ordenes al asistente.
# Formato internacional sin espacios, ej: +5215512345678
OWNER_PHONE_NUMBER=

# Proveedor de WhatsApp: consola | twilio | meta
# "consola" = modo prueba local, los mensajes se imprimen en terminal
WHATSAPP_PROVIDER=consola

# --- Si WHATSAPP_PROVIDER=twilio ---
# TWILIO_ACCOUNT_SID=...
# TWILIO_AUTH_TOKEN=...
# TWILIO_PHONE_NUMBER=+14155238886

# --- Si WHATSAPP_PROVIDER=meta ---
# META_ACCESS_TOKEN=...
# META_PHONE_NUMBER_ID=...
# META_VERIFY_TOKEN=mi-asistente-2026

# Servidor
PORT=8000
ENVIRONMENT=development

# Base de datos
DATABASE_URL=sqlite+aiosqlite:///./asistente.db

# Zona horaria para recordatorios (nombre IANA)
TIMEZONE=America/Mexico_City
